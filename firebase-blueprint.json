{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A retail product in KhatiRaj BD v2.1.",
      "type": "object",
      "properties": {
        "nameBn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "shortSummaryBn": { "type": "string", "maxLength": 600 },
        "descriptionBn": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "descriptionEn": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "category": {
          "type": "string",
          "enum": [
            "honey",
            "ghee_oil",
            "superfoods",
            "nuts_dates",
            "wellness",
            "skincare",
            "kitchen_cutlery",
            "combo",
            "fashion",
            "electronics",
            "jewellery",
            "organic_food",
            "home_lifestyle"
          ],
          "maxLength": 40
        },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "isFlashSale": { "type": "boolean" },
        "stock": { "type": "number" },
        "unitLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 250000 },
        "galleryUrls": { "type": "array", "maxItems": 30 },
        "galleryItems": { "type": "array", "maxItems": 30 },
        "videoUrl": { "type": "string", "maxLength": 1000 },
        "variants": { "type": "array", "maxItems": 50 },
        "highlights": { "type": "array", "maxItems": 30 },
        "specifications": { "type": "array", "maxItems": 40 },
        "faqs": { "type": "array", "maxItems": 30 },
        "wholesaleTiers": { "type": "array", "maxItems": 20 },
        "upsellProductIds": { "type": "array", "maxItems": 20 },
        "freeDelivery": { "type": "boolean" },
        "weightGrams": { "type": "number" },
        "warrantyText": { "type": "string", "maxLength": 300 },
        "returnPolicyText": { "type": "string", "maxLength": 300 },
        "badgeLabel": { "type": "string", "maxLength": 80 },
        "slug": { "type": "string", "maxLength": 200 },
        "focusKeyphrase": { "type": "string", "maxLength": 200 },
        "relatedKeyphrases": { "type": "string", "maxLength": 500 },
        "seoTitle": { "type": "string", "maxLength": 250 },
        "metaDescription": { "type": "string", "maxLength": 500 },
        "canonicalUrl": { "type": "string", "maxLength": 500 },
        "metaRobotsIndex": { "type": "string", "enum": ["index", "noindex"], "maxLength": 20 },
        "metaRobotsFollow": { "type": "string", "enum": ["follow", "nofollow"], "maxLength": 20 },
        "ogTitle": { "type": "string", "maxLength": 250 },
        "ogDescription": { "type": "string", "maxLength": 500 },
        "ogImageUrl": { "type": "string", "maxLength": 1000 },
        "twitterTitle": { "type": "string", "maxLength": 250 },
        "twitterDescription": { "type": "string", "maxLength": 500 },
        "twitterImageUrl": { "type": "string", "maxLength": 1000 },
        "schemaBrand": { "type": "string", "maxLength": 150 },
        "schemaSku": { "type": "string", "maxLength": 120 },
        "schemaGtin": { "type": "string", "maxLength": 120 },
        "schemaMpn": { "type": "string", "maxLength": 120 },
        "schemaCondition": {
          "type": "string",
          "enum": ["NewCondition", "RefurbishedCondition", "UsedCondition"],
          "maxLength": 40
        },
        "schemaAvailability": {
          "type": "string",
          "enum": ["InStock", "OutOfStock", "PreOrder"],
          "maxLength": 40
        },
        "imageAltText": { "type": "string", "maxLength": 300 },
        "isCornerstone": { "type": "boolean" },
        "internalLinksUrl": { "type": "string", "maxLength": 500 },
        "outboundLinkUrl": { "type": "string", "maxLength": 500 },
        "redirectOldSlug": { "type": "string", "maxLength": 250 },
        "seoScore": { "type": "number" },
        "readabilityScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "nameBn",
        "nameEn",
        "descriptionBn",
        "descriptionEn",
        "category",
        "price",
        "salePrice",
        "isFlashSale",
        "stock",
        "unitLabel",
        "imageUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount coupon.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Z0-9_\\-]+$" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"], "maxLength": 20 },
        "discountValue": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "descriptionBn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "descriptionEn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "code",
        "discountType",
        "discountValue",
        "minOrderAmount",
        "descriptionBn",
        "descriptionEn",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with PII, online payment verification, and Steadfast courier state.",
      "type": "object",
      "properties": {
        "orderCode": { "type": "string", "minLength": 4, "maxLength": 32, "pattern": "^[A-Z0-9\\-]+$" },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "customerPhone": { "type": "string", "minLength": 11, "maxLength": 11, "pattern": "^01[3-9][0-9]{8}$" },
        "district": { "type": "string", "minLength": 2, "maxLength": 60 },
        "address": { "type": "string", "minLength": 4, "maxLength": 400 },
        "deliveryZone": { "type": "string", "enum": ["inside_dhaka", "outside_dhaka"], "maxLength": 20 },
        "itemsSummary": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "itemCount": { "type": "number" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "couponCode": { "type": "string", "minLength": 1, "maxLength": 32 },
        "deliveryCharge": { "type": "number" },
        "totalPayable": { "type": "number" },
        "paymentMethod": {
          "type": "string",
          "enum": ["COD", "bKash", "Nagad", "Rocket", "Upay", "Bank"],
          "maxLength": 20
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Unpaid", "Pending Verification", "Paid", "Rejected"],
          "maxLength": 30
        },
        "transactionId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "senderPhone": { "type": "string", "minLength": 1, "maxLength": 20 },
        "steadfastConsignmentId": { "type": "string", "minLength": 1, "maxLength": 60 },
        "steadfastStatus": { "type": "string", "minLength": 1, "maxLength": 60 },
        "adminNote": { "type": "string", "minLength": 1, "maxLength": 500 },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Shipped", "Delivered", "Cancelled"],
          "maxLength": 20
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderCode",
        "customerName",
        "customerPhone",
        "district",
        "address",
        "deliveryZone",
        "itemsSummary",
        "itemCount",
        "subtotal",
        "discountAmount",
        "couponCode",
        "deliveryCharge",
        "totalPayable",
        "paymentMethod",
        "paymentStatus",
        "transactionId",
        "senderPhone",
        "steadfastConsignmentId",
        "steadfastStatus",
        "adminNote",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderTracking": {
      "title": "OrderTracking",
      "description": "PII-free public tracking document keyed by orderCode.",
      "type": "object",
      "properties": {
        "orderCode": { "type": "string", "minLength": 4, "maxLength": 32, "pattern": "^[A-Z0-9\\-]+$" },
        "itemsSummary": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "itemCount": { "type": "number" },
        "deliveryZone": { "type": "string", "enum": ["inside_dhaka", "outside_dhaka"], "maxLength": 20 },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "totalPayable": { "type": "number" },
        "paymentMethod": {
          "type": "string",
          "enum": ["COD", "bKash", "Nagad", "Rocket", "Upay", "Bank"],
          "maxLength": 20
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Unpaid", "Pending Verification", "Paid", "Rejected"],
          "maxLength": 30
        },
        "steadfastConsignmentId": { "type": "string", "minLength": 1, "maxLength": 60 },
        "steadfastStatus": { "type": "string", "minLength": 1, "maxLength": 60 },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Shipped", "Delivered", "Cancelled"],
          "maxLength": 20
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderCode",
        "itemsSummary",
        "itemCount",
        "deliveryZone",
        "subtotal",
        "discountAmount",
        "deliveryCharge",
        "totalPayable",
        "paymentMethod",
        "paymentStatus",
        "steadfastConsignmentId",
        "steadfastStatus",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AbandonedCart": {
      "title": "AbandonedCart",
      "description": "Incomplete checkout session saved for WhatsApp/SMS follow-up.",
      "type": "object",
      "properties": {
        "cartCode": { "type": "string", "minLength": 4, "maxLength": 40 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "customerPhone": { "type": "string", "minLength": 11, "maxLength": 11, "pattern": "^01[3-9][0-9]{8}$" },
        "district": { "type": "string", "minLength": 1, "maxLength": 60 },
        "address": { "type": "string", "minLength": 1, "maxLength": 400 },
        "itemsSummary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "subtotal": { "type": "number" },
        "recoveryStatus": { "type": "string", "enum": ["New", "Reminded", "Recovered"], "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "cartCode",
        "customerName",
        "customerPhone",
        "district",
        "address",
        "itemsSummary",
        "subtotal",
        "recoveryStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "Slider": {
      "title": "Slider",
      "description": "Hero carousel or promotional banner slide.",
      "type": "object",
      "properties": {
        "titleBn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "subtitleBn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "subtitleEn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "btnTextBn": { "type": "string", "minLength": 1, "maxLength": 60 },
        "btnTextEn": { "type": "string", "minLength": 1, "maxLength": 60 },
        "btnLink": { "type": "string", "minLength": 1, "maxLength": 200 },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 250000 },
        "sliderType": { "type": "string", "enum": ["hero", "promo"], "maxLength": 20 },
        "isActive": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "titleBn",
        "titleEn",
        "subtitleBn",
        "subtitleEn",
        "btnTextBn",
        "btnTextEn",
        "btnLink",
        "imageUrl",
        "sliderType",
        "isActive",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "Storefront health, honey, and lifestyle blog post.",
      "type": "object",
      "properties": {
        "titleBn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "categoryBn": { "type": "string", "minLength": 1, "maxLength": 80 },
        "excerptBn": { "type": "string", "minLength": 1, "maxLength": 500 },
        "contentBn": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 250000 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "titleBn",
        "titleEn",
        "categoryBn",
        "excerptBn",
        "contentBn",
        "imageUrl",
        "authorName",
        "isPublished",
        "createdAt",
        "updatedAt"
      ]
    },
    "LandingPage": {
      "title": "LandingPage",
      "description": "Single-product promotional landing page with direct checkout.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "minLength": 2, "maxLength": 80 },
        "titleBn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subtitleBn": { "type": "string", "minLength": 1, "maxLength": 400 },
        "productId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "heroImageUrl": { "type": "string", "minLength": 1, "maxLength": 250000 },
        "bulletPointsSummary": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "specialOfferText": { "type": "string", "minLength": 1, "maxLength": 200 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "slug",
        "titleBn",
        "subtitleBn",
        "productId",
        "heroImageUrl",
        "bulletPointsSummary",
        "specialOfferText",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product review and rating.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "productName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["Approved", "Pending"], "maxLength": 20 },
        "adminReply": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "productId",
        "productName",
        "customerName",
        "rating",
        "comment",
        "status",
        "adminReply",
        "createdAt",
        "updatedAt"
      ]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global KhatiRaj BD store, payment gateway, courier, and tracking pixel settings.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "logoUrl": { "type": "string", "maxLength": 250000 },
        "siteTagline": { "type": "string", "maxLength": 160 },
        "supportPhone": { "type": "string", "minLength": 1, "maxLength": 40 },
        "supportEmail": { "type": "string", "minLength": 1, "maxLength": 100 },
        "whatsappNumber": { "type": "string", "minLength": 1, "maxLength": 30 },
        "insideDhakaCharge": { "type": "number" },
        "outsideDhakaCharge": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" },
        "flashSaleTitleBn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "flashSaleEndTime": { "type": "string", "minLength": 1, "maxLength": 60 },
        "flashSaleActive": { "type": "boolean" },
        "bkashNumber": { "type": "string", "minLength": 1, "maxLength": 30 },
        "nagadNumber": { "type": "string", "minLength": 1, "maxLength": 30 },
        "rocketNumber": { "type": "string", "minLength": 1, "maxLength": 30 },
        "upayNumber": { "type": "string", "minLength": 1, "maxLength": 30 },
        "bankDetails": { "type": "string", "minLength": 1, "maxLength": 500 },
        "steadfastApiKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "steadfastSecretKey": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fbPixelId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tiktokPixelId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "gaMeasurementId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "siteName",
        "supportPhone",
        "supportEmail",
        "whatsappNumber",
        "insideDhakaCharge",
        "outsideDhakaCharge",
        "freeDeliveryThreshold",
        "flashSaleTitleBn",
        "flashSaleEndTime",
        "flashSaleActive",
        "bkashNumber",
        "nagadNumber",
        "rocketNumber",
        "upayNumber",
        "bankDetails",
        "steadfastApiKey",
        "steadfastSecretKey",
        "fbPixelId",
        "tiktokPixelId",
        "gaMeasurementId",
        "updatedAt"
      ]
    },
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Verified administrator account record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public storefront product catalog."
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional discount coupons."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders containing PII, payment verification, and Steadfast courier state."
    },
    "/orderTracking/{orderCode}": {
      "schema": { "$ref": "#/entities/OrderTracking" },
      "description": "PII-free public order tracking summaries."
    },
    "/abandonedCarts/{cartId}": {
      "schema": { "$ref": "#/entities/AbandonedCart" },
      "description": "Incomplete checkout leads for admin WhatsApp recovery."
    },
    "/sliders/{sliderId}": {
      "schema": { "$ref": "#/entities/Slider" },
      "description": "Hero and promotional banners."
    },
    "/blogPosts/{postId}": {
      "schema": { "$ref": "#/entities/BlogPost" },
      "description": "Store blog articles."
    },
    "/landingPages/{pageId}": {
      "schema": { "$ref": "#/entities/LandingPage" },
      "description": "Single-product promotional landing pages."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer product reviews."
    },
    "/siteSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global site, payment, courier, and tracking pixel settings."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminProfile" },
      "description": "Verified administrators."
    }
  }
}
